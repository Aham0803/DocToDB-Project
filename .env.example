# ==========================================
# Document to Database (DocToDB) Environment
# ==========================================

# --- API Security ---
API_SECRET_KEY=doctodb_secret_api_key_2026_secure
ENVIRONMENT=development

# --- LLM Provider Configuration ---
# Options: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API (Optional / For Provider Comparison)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Optional Local Air-Gapped)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# --- MySQL Database Configuration ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=doc_to_db
MYSQL_USER=doctodb_user
MYSQL_PASSWORD=doctodb_password
MYSQL_ROOT_PASSWORD=root_password_secure

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=/app/data/chroma_db
CHROMA_COLLECTION_NAME=financial_invoices

# --- Auto-Approval Thresholds ---
CONFIDENCE_AUTO_APPROVE_THRESHOLD=0.88
MAX_SELF_CORRECTION_RETRIES=1

# --- Optional Langfuse Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
